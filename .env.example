# Database: local file by default; in production on Vercel, a Turso database (turso db show --url / turso db tokens create)
# (the Vercel Turso integration creates TURSO_DATABASE_URL / TURSO_AUTH_TOKEN: they are read too, nothing to copy)
# NUXT_DB_URL=libsql://prixly-<org>.turso.io
# NUXT_DB_AUTH_TOKEN=

# App access code (empty = open to everyone): set it as soon as the app is online
NUXT_ACCESS_CODE=

# eBay search (Browse API, free): developer.ebay.com → Application Keys → Production
# (App ID = client id, Cert ID = client secret). Empty: search only shows links.
NUXT_EBAY_CLIENT_ID=
NUXT_EBAY_CLIENT_SECRET=

# AI (sorting eBay listings, search assistant). Without any key, AI buttons are hidden.
# Free option: Groq (no credit card, rate-limited) — https://console.groq.com/keys
LLM_API_KEY=
# Optional: another OpenAI-compatible service (Gemini, OpenRouter, Cerebras…) and/or another model
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Web search model (Groq browser_search; separate rate limit from LLM_MODEL)
# LLM_WEB_SEARCH_MODEL=openai/gpt-oss-20b
# Paid option: Claude — https://console.anthropic.com (takes priority when set)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Only for a key created outside a workspace ("not scoped to a workspace" error): the wrkspc_… workspace ID
# NUXT_ANTHROPIC_WORKSPACE_ID=
# Force a provider: anthropic | openai-compatible
# LLM_PROVIDER=

# Web Push (pnpm vapid)
NUXT_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:you@example.com

# Scheduled price checks through /api/cron/refresh (Vercel): secret shared with the external cron (openssl rand -hex 32)
# CRON_SECRET=
# PRIXLY_REFRESH_INTERVAL_H=6
# PRIXLY_REFRESH_BUDGET_SEC=50

# Proxy for scraping (recommended on Vercel: datacenter IPs get blocked quickly)
# PRIXLY_PROXY_URL=
