# Base : fichier local par défaut ; en prod Vercel, une base Turso (turso db show --url / turso db tokens create)
# NUXT_DB_URL=libsql://prixly-<org>.turso.io
# NUXT_DB_AUTH_TOKEN=

# Web Push (pnpm vapid)
NUXT_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:toi@example.com

# Relevé planifié via /api/cron/refresh (Vercel) : secret partagé avec le cron externe (openssl rand -hex 32)
# CRON_SECRET=
# PRIXLY_REFRESH_INTERVAL_H=6
# PRIXLY_REFRESH_BUDGET_SEC=50

# Proxy pour le scraping (recommandé sur Vercel : les IP de datacenter sont vite bloquées)
# PRIXLY_PROXY_URL=
